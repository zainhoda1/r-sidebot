# Supabase connection, read by both surveydown (survey responses) and
# R/supabase_log.R (chat logs and transcripts). Copy to .env and fill in; .env
# is gitignored.
#
# Take these from Supabase > Project Settings > Database > Connection string,
# and use the SESSION POOLER entry, not "direct connection". The direct host
# (db.<project-ref>.supabase.co) is IPv6-only, so it works on your machine and
# fails once deployed to shinyapps.io.

SD_HOST=aws-0-<region>.pooler.supabase.com
SD_PORT=6543
SD_DBNAME=postgres
SD_USER=postgres.<project-ref>
SD_PASSWORD=<your-database-password>

# Table surveydown writes the survey responses to
SD_TABLE=llm_explain_control
